# Local development database credentials only. Never reuse these in production.
POSTGRES_DB=lume_beauty
POSTGRES_USER=lume_app
POSTGRES_PASSWORD=lume_dev_password

# The host port is 5433 to avoid colliding with another local PostgreSQL server.
DATABASE_URL=postgresql://lume_app:lume_dev_password@127.0.0.1:5433/lume_beauty
PORT=3001
